<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background" android:paddingHorizontal="12dp" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/node_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Tokyo · 01" android:textColor="@color/widget_ink" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/refresh" android:layout_width="32dp" android:layout_height="26dp"
            android:background="@android:color/transparent" android:src="@drawable/ic_refresh" android:contentDescription="刷新卡片" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/latency" style="@style/WidgetValue" android:text="28.4" android:textSize="20sp" android:textColor="@color/widget_accent" />
            <TextView android:id="@+id/latency_label" style="@style/WidgetLabel" android:text="延迟 · ms" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp">
            <TextView android:id="@+id/loss" style="@style/WidgetValue" android:text="0.7" android:textSize="20sp" android:textColor="@color/widget_good" />
            <TextView style="@style/WidgetLabel" android:text="丢包率 · %" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/footer" style="@style/WidgetLabel" android:text="● 在线 · 香港 · 12:00" android:textSize="10sp" />
</LinearLayout>
